{
  "id": "./",
  "name": "Markdown Chat Reader",
  "short_name": "Chat Reader",
  "description": "Read an AI chat Markdown export as a mobile-style chat. Runs in your browser, also offline. Your chats are never uploaded or saved.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#f2f5f3",
  "theme_color": "#f2f5f3",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["text/markdown", "text/x-markdown", "text/plain", "text/*", "application/octet-stream", ".md", ".markdown", ".txt"] }
      ]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
